# Copy to .env and fill in. Never commit .env.

# --- Person B, adapters/voice.jac -------------------------------------------
# Deepgram Nova-3 batch transcription (B3).
DEEPGRAM_API_KEY=

# ElevenLabs Agents outbound calling (B6). These three are the ONLY telephony
# vars the code reads -- see adapters/voice.jac place_call().
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# --- Telephony route A: the SignalWire media-stream bridge (PREFERRED) -------
# Set BRIDGE_URL and place_call() routes through bridge/server.mjs instead of
# ElevenLabs-native telephony. This is how VoiceSRE did it, and it exists for a
# concrete reason: a Twilio TRIAL account prepends a spoken trial notice to
# every call AND strips <Connect><Stream> from TwiML. SignalWire has neither
# restriction, so the demo call is clean without upgrading anything.
#
# BRIDGE_URL  - where adapters/voice.jac POSTs (the deployed bridge, e.g. Render)
# PUBLIC_URL  - the bridge's OWN public https URL, set in the bridge's env.
#               SignalWire fetches TwiML from it and opens the media websocket
#               against it, so the bridge must know its own hostname.
BRIDGE_URL=
PUBLIC_URL=

# --- Telephony route B: ElevenLabs-native (fallback, works today) ------------
# Used when BRIDGE_URL is unset. Requires a number imported INTO ElevenLabs;
# ELEVENLABS_PHONE_NUMBER_ID is the id that import returns, not an E.164 number.
# Verified working with a Twilio number, but a trial account adds a spoken
# trial notice before the agent speaks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- SignalWire: used by the bridge, and for the (dead) SIP route ------------
# NOTE: the ElevenLabs SIP-trunk route does NOT work with SignalWire SIP
# endpoints -- every transport/port/domain returns 404 "Domain unavailable",
# because those endpoints host registered devices and do not terminate calls to
# arbitrary numbers. Use the bridge above instead.
# ElevenLabs provisions no numbers itself on any tier, so the SignalWire number
# is registered INSIDE ElevenLabs as a generic SIP trunk. ElevenLabs then hands
# back a phone_number_id, which is what place_call() actually sends as
# `agent_phone_number_id`. The values below are what you need to perform that
# one-time import; nothing in the codebase reads them at runtime.
SIGNALWIRE_SPACE_URL=            # e.g. yourspace.signalwire.com
SIGNALWIRE_PHONE_NUMBER=         # E.164, the caller ID you own in SignalWire
SIGNALWIRE_SIP_USERNAME=         # SIP endpoint username (create in SignalWire)
SIGNALWIRE_SIP_PASSWORD=         # SIP endpoint password
SIGNALWIRE_PROJECT_ID=           # only needed if you script SignalWire itself
SIGNALWIRE_TOKEN=

# --- Shared: jac.toml model routing (Person A) + omission.jac was_conveyed() -
DEEPSEEK_API_KEY=
